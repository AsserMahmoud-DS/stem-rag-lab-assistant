<node id="Digital Word">
  <data key="d0">Digital Word</data>
  <data key="d1">data</data>
  <data key="d2">The digital value contained in the counter, which is proportional to the level of the analog signal.</data>
  <data key="d3">chapter 5  ADC and DAC::ch_00035-chunk-000</data>
  <data key="d4">unknown_source</data>
