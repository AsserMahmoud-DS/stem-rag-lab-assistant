<graph edgedefault="undirected"><node id="Gross Errors">
  <data key="d0">Gross Errors</data>
  <data key="d1">concept</data>
  <data key="d2">Gross Errors are human errors caused by the operator or person using an instrument, where the measurement goes wrong due to the operator despite the instrument potentially being functional and free of inherent error.&lt;SEP&gt;Gross errors are a category of measurement errors classified alongside systematic and random errors.&lt;SEP&gt;Gross errors are a type of measurement error that can be avoided by taking proper care.</data>
  <data key="d3">chapter-1 Error in measurement::ch_00002-chunk-000&lt;SEP&gt;chapter-1 Error in measurement::ch_00001-chunk-000&lt;SEP&gt;chapter-1 Error in measurement::ch_00007-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790517985</data>
  <data key="d6"></data>
</node>
<node id="Operator">
  <data key="d0">Operator</data>
  <data key="d1">person</data>
  <data key="d2">The individual person using the instrument who may cause gross errors through human fault.</data>
  <data key="d3">chapter-1 Error in measurement::ch_00002-chunk-000</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1790508003</data>
  <data key="d6"></data>
</node>
